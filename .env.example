# NitroStack Python SDK / CLI — analytics (see docs/analytics-events.md)
# Optional: override the built-in public PostHog project key (never commit non-public values).
NITROSTACK_POSTHOG_KEY=
# Optional: PostHog ingest host (default US Cloud).
NITROSTACK_POSTHOG_HOST=https://us.i.posthog.com
# production | staging | development (default: inferred from NODE_ENV / CI).
NITROSTACK_ENVIRONMENT=
# Set to 0/false/off to disable CLI telemetry (DO_NOT_TRACK=1 also disables).
NITROSTACK_TELEMETRY=
